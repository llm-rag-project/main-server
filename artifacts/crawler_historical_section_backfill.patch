+def _historical_naver_search_pages(published_before: str | None) -> int:
+    if not published_before:
+        return 1
+    try:
+        end_at = datetime.fromisoformat(str(published_before).replace("Z", "+00:00"))
+    except ValueError:
+        return 1
+    if end_at.tzinfo is None:
+        end_at = end_at.replace(tzinfo=timezone.utc)
+    else:
+        end_at = end_at.astimezone(timezone.utc)
+    return 10 if end_at < datetime.now(timezone.utc) - timedelta(days=3) else 1
